rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // PRODUCTION RULES FOR MEDILINK
    
    // Cases Collection
    match /cases/{caseId} {
      allow read: if true;
      allow create: if request.resource.data.patientPhone != null;
      allow update: if true; // In full production, restrict by role
    }
    
    // Chats Subcollection
    match /chats/{caseId}/messages/{messageId} {
      allow read, write: if true; // In full production, restrict by role/auth
    }
    
    // Fallback block for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
